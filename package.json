{
  "name": "bdi-cleaning-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.client.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:init": "node database-bdi-cleaning/scripts/init-database.mjs",
    "db:verify": "node database-bdi-cleaning/scripts/verify-database.mjs",
    "db:migrate:local": "wrangler d1 migrations apply bdi-cleaning-control --local",
    "db:seed:local": "wrangler d1 execute bdi-cleaning-control --local --file=database-bdi-cleaning/seeds/areas.sql && wrangler d1 execute bdi-cleaning-control --local --file=database-bdi-cleaning/seeds/holidays_2026.sql && wrangler d1 execute bdi-cleaning-control --local --file=database-bdi-cleaning/seeds/settings.sql",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "hono": "^4.9.2",
    "jszip": "^3.10.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.11.2",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5",
    "wrangler": "^4.30.0"
  }
}
