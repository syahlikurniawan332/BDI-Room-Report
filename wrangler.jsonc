{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bdi-cleaning-control",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bdi-cleaning-control",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "database-bdi-cleaning/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTO_BUCKET",
      "bucket_name": "bdi-cleaning-photos",
    },
  ],
  "triggers": {
    "crons": ["0 1 * * *"],
  },
  "vars": {
    "APP_ENV": "development",
    "ADMIN_NOTIFICATION_EMAIL": "canvaprobos@gmail.com",
  },
}
